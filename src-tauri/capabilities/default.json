{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for KiVault main window",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-get-vault-status",
    "allow-get-vault-summary",
    "allow-change-master-password",
    "allow-create-platform",
    "allow-list-platforms",
    "allow-get-platform",
    "allow-update-platform",
    "allow-delete-platform",
    "allow-create-account",
    "allow-list-accounts",
    "allow-search-accounts",
    "allow-get-account-detail",
    "allow-update-account",
    "allow-delete-account",
    "allow-create-tag",
    "allow-list-tags",
    "allow-rename-tag",
    "allow-delete-tag",
    "allow-assign-tag",
    "allow-remove-tag",
    "allow-reveal-secret",
    "allow-copy-secret",
    "allow-generate-password",
    "allow-get-settings",
    "allow-update-security-settings",
    "allow-update-password-generator-settings",
    "allow-get-security-status",
    "allow-get-password-health",
    "allow-notify-activity",
    "allow-import-logo",
    "allow-list-logos",
    "allow-get-logo",
    "allow-rename-logo",
    "allow-replace-logo",
    "allow-delete-logo",
    "allow-assign-logo"
  ]
